#!/usr/bin/env python3
"""
Stop hook: post any unlogged assistant text to the source Discord channel.

Two jobs:
1. Flush text produced *after the last tool call* — the text extractor only
   fires on PreToolUse/PostToolUse, so final-turn text (e.g. "context safe to
   clear") is never flushed otherwise. Uses the text-extractor state file to
   avoid double-posting.
2. Safety-net: if Claude never used the reply tool this turn, post last text.

Called with: session_id transcript_path
Reads DISCORD_BOT_TOKEN from discord-webhook.conf; falls back to openclaw.json.

--- 2026-07-03 duplication fix -------------------------------------------------
Root cause of "same message up to 4x in the discussion channel": the Stop event
can fire more than once per turn (batchc-stop-gate.py exit-2 continuation is on
the same Stop event; Claude Code also re-runs Stop hooks on continuations), and
discord-notify.sh re-invokes this script on every fire. Job 2 previously posted
to the discussion channel WITHOUT advancing any cursor or dedup marker, so every
extra fire re-posted the identical text. The 07-01 sequential-ordering change made
it worse: text-extract now always advances the .txt cursor before this script
runs, so Job 1 always sees an empty backlog and always falls through to the
non-idempotent Job 2.

Three defenses added (belt-and-suspenders):
  A. Per-session non-blocking lock (fcntl) — concurrent Stop fires serialize;
     the loser exits cleanly.
  B. Content-hash dedup guard (discord_outbound.is_duplicate, via .send) — an
     identical (session, channel, text) posted within the dedup window is
     suppressed regardless of how it got re-triggered.
  C. Job 2 now advances the .txt cursor to end, so a later fire finds no backlog.

Also: the replied-branch used to mirror trailing narrative to the *discussion*
channel, duplicating what the reply tool already put there. That trailing text is
now routed to the LOG channel instead (it is post-reply narrative, not the reply
body). The discussion channel gets exactly one thing from this hook per turn.
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    import discord_outbound as ob
except Exception:
    ob = None

CONF_PATH = os.path.expanduser('~/.claude/hooks/discord-webhook.conf')
CHANNEL_TAG_RE = re.compile(r'<channel[^>]+source="plugin:discord:discord"[^>]+chat_id="(\d+)"')

QUESTION_PHRASES = ('which', 'would you like', 'do you want', 'should i', 'can you')

MODEL_SWITCH_RE = re.compile(r'Model (?:set to|reset to default)\b.*?\(([a-zA-Z0-9_][a-zA-Z0-9_./-]*)\)\.')


def _state_dir():
    return os.environ.get('DISCORD_HOOK_STATE_DIR') or os.path.expanduser('~/.claude/hooks/state')


def load_conf():
    bot_token = ''
    alert_user_id = ''
    try:
        with open(CONF_PATH) as f:
            for line in f:
                line = line.strip()
                if line.startswith('#'):
                    continue
                if line.startswith('DISCORD_BOT_TOKEN='):
                    bot_token = line.partition('=')[2].strip().strip('"').strip("'")
                elif line.startswith('DISCORD_ALERT_USER_ID='):
                    alert_user_id = line.partition('=')[2].strip().strip('"').strip("'")
    except Exception:
        pass
    if not bot_token:
        try:
            plugin_env = os.path.expanduser('~/.claude/channels/discord/.env')
            with open(plugin_env) as f:
                for line in f:
                    line = line.strip()
                    if line.startswith('DISCORD_BOT_TOKEN='):
                        bot_token = line.partition('=')[2].strip()
                        break
        except Exception:
            pass
    return bot_token, alert_user_id


def get_user_content_str(entry):
    content = entry.get('message', {}).get('content', '')
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for b in content:
            if isinstance(b, dict) and b.get('type') == 'text':
                parts.append(b.get('text', ''))
        return '\n'.join(parts)
    return ''


def is_question(text):
    lower = text.lower()
    if lower.rstrip().endswith('?'):
        return True
    return any(phrase in lower for phrase in QUESTION_PHRASES)


def _resolve_log_channel(session_id):
    """Return the log channel ID for this session using per-session state files."""
    log_channels_path = os.path.expanduser('~/.claude/hooks/discord-log-channels.json')
    try:
        mapping = json.load(open(log_channels_path))
    except Exception:
        return ''
    state_dir = _state_dir()
    for suffix in ('routechatid', 'chatid'):
        try:
            chat_id = open(os.path.join(state_dir, f'{session_id}.{suffix}')).read().strip()
            if chat_id and chat_id in mapping:
                return mapping[chat_id]
        except Exception:
            pass
    env_chat_id = os.environ.get('DISCORD_CHAT_ID', '')
    if env_chat_id and env_chat_id in mapping:
        return mapping[env_chat_id]
    return ''


def _log_webhook_url(session_id):
    """Resolve the LOG-channel *webhook URL* for this session (mirrors
    discord-notify.sh resolve_log_webhook). Used to route post-reply narrative to
    the log channel instead of duplicating it into the discussion channel."""
    routing_path = os.path.expanduser('~/.claude/hooks/discord-routing.json')
    try:
        routing = json.load(open(routing_path))
    except Exception:
        return ''
    state_dir = _state_dir()
    chat_id = ''
    for suffix in ('routechatid', 'chatid'):
        try:
            v = open(os.path.join(state_dir, f'{session_id}.{suffix}')).read().strip()
            if v:
                chat_id = v
                break
        except Exception:
            pass
    if not chat_id:
        chat_id = os.environ.get('DISCORD_CHAT_ID', '')
    var_name = routing.get(chat_id, '')
    return os.environ.get(var_name, '') if var_name else ''


def _post_discussion(session_id, chat_id, bot_token, text, event, payload=None,
                     dedup_key=None):
    """POST to the discussion (source) channel via bot API, deduped + audited."""
    url = f'https://discord.com/api/v10/channels/{chat_id}/messages'
    auth = f'Authorization: Bot {bot_token}'
    if ob:
        return ob.send(session_id, event, chat_id, 'discussion', url, text,
                       auth_header=auth, payload=payload, dedup_key=dedup_key)
    import subprocess
    body = payload if payload is not None else json.dumps({'content': text})
    subprocess.run(['/usr/bin/curl', '-s', '-o', '/dev/null', '--max-time', '10',
                    '-X', 'POST', url, '-H', auth,
                    '-H', 'Content-Type: application/json', '-d', body], check=False)
    return None


def main():
    if len(sys.argv) < 3:
        sys.exit(0)

    session_id = sys.argv[1]
    jsonl_path = sys.argv[2]

    bot_token, alert_user_id = load_conf()
    if not bot_token:
        sys.exit(0)
    if not os.path.exists(jsonl_path):
        sys.exit(0)

    # --- Defense A: per-session non-blocking lock. If another Stop fire for this
    #     session is already inside stop-check, exit — it will do the work. This
    #     serializes overlapping/duplicate Stop events (the 4x driver). ----------
    lock_fh = None
    try:
        import fcntl
        os.makedirs(_state_dir(), exist_ok=True)
        lock_fh = open(os.path.join(_state_dir(), f'{session_id}.stopcheck.lock'), 'w')
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except Exception:
        sys.exit(0)   # lock held by a concurrent fire → let that one handle it

    entries = []
    with open(jsonl_path) as f:
        for line in f:
            try:
                entries.append(json.loads(line))
            except Exception:
                pass

    last_discord_chat_id = None
    last_discord_idx = -1
    for i, entry in enumerate(entries):
        if entry.get('type') == 'user':
            text = get_user_content_str(entry)
            m = CHANNEL_TAG_RE.search(text)
            if m:
                last_discord_chat_id = m.group(1)
                last_discord_idx = i

    if not last_discord_chat_id or last_discord_idx < 0:
        sys.exit(0)

    # --- Model switch detection (unchanged) ---
    state_dir = _state_dir()
    model_state_file = os.path.join(state_dir, f'{session_id}.model')
    for entry in entries[last_discord_idx:]:
        if entry.get('type') != 'assistant':
            continue
        content = entry.get('message', {}).get('content', [])
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict) or block.get('type') != 'text':
                continue
            m = MODEL_SWITCH_RE.search(block.get('text', ''))
            if m:
                try:
                    os.makedirs(state_dir, exist_ok=True)
                    with open(model_state_file, 'w') as f:
                        f.write(m.group(1))
                except Exception:
                    pass

    # --- Job 1: flush unposted text since last text-extractor run → discussion ---
    state_file = os.path.join(state_dir, f'{session_id}.txt')
    last_processed_line = 0
    if os.path.exists(state_file):
        try:
            last_processed_line = int(open(state_file).read().strip())
        except Exception:
            pass

    unposted = []
    for i, entry in enumerate(entries):
        if i < last_processed_line:
            continue
        if entry.get('type') != 'assistant':
            continue
        content = entry.get('message', {}).get('content', [])
        if not isinstance(content, list):
            continue
        for block in content:
            if isinstance(block, dict) and block.get('type') == 'text':
                t = block.get('text', '').strip()
                if t:
                    unposted.append(t)

    if unposted:
        for text in unposted:
            if len(text) > 1900:
                text = text[:1897] + '...'
            _post_discussion(session_id, last_discord_chat_id, bot_token, text,
                             'Stop-job1-flush',
                             dedup_key=f'job1|t{last_discord_idx}|{text}')
        try:
            with open(state_file, 'w') as f:
                f.write(str(len(entries)))
        except Exception:
            pass
        sys.exit(0)

    # --- Job 2: safety-net when Claude never used the reply tool this turn ---
    replied = False
    last_text = ''
    for entry in entries[last_discord_idx + 1:]:
        if entry.get('type') != 'assistant':
            continue
        content = entry.get('message', {}).get('content', [])
        if not isinstance(content, list):
            continue
        for block in content:
            if not isinstance(block, dict):
                continue
            if block.get('type') == 'tool_use' and block.get('name') == 'mcp__plugin_discord_discord__reply':
                replied = True
            if block.get('type') == 'text':
                t = block.get('text', '').strip()
                if t:
                    last_text = t

    if replied:
        post_discord_entries = entries[last_discord_idx + 1:]
        last_reply_entry_idx = -1
        for i, entry in enumerate(post_discord_entries):
            if entry.get('type') != 'assistant':
                continue
            content = entry.get('message', {}).get('content', [])
            if not isinstance(content, list):
                continue
            for block in content:
                if (isinstance(block, dict)
                        and block.get('type') == 'tool_use'
                        and block.get('name') == 'mcp__plugin_discord_discord__reply'):
                    last_reply_entry_idx = i

        post_reply_texts = []
        if last_reply_entry_idx >= 0:
            for entry in post_discord_entries[last_reply_entry_idx + 1:]:
                if entry.get('type') != 'assistant':
                    continue
                content = entry.get('message', {}).get('content', [])
                if not isinstance(content, list):
                    continue
                for block in content:
                    if isinstance(block, dict) and block.get('type') == 'text':
                        t = block.get('text', '').strip()
                        if t:
                            post_reply_texts.append(t)

        # Trailing narrative AFTER the reply tool call. This is NOT the reply body
        # (the reply tool already delivered that to the discussion channel), so
        # route it to the LOG channel — posting it to discussion is the mirror that
        # produced duplicate copies. Deduped + audited.
        log_url = _log_webhook_url(session_id)
        for text in post_reply_texts:
            if len(text) > 1900:
                text = text[:1897] + '...'
            if ob and log_url:
                ob.send(session_id, 'Stop-postreply-log', last_discord_chat_id,
                        'log', log_url, f'> {text}',
                        dedup_key=f'{text}|t{last_discord_idx}')
            elif ob:
                # no log webhook resolved: record the drop so it's visible
                ob.audit(session_id, 'Stop-postreply-log', last_discord_chat_id,
                         'log', 'dropped', 'no-url', text)

        # Advance the cursor so a later Stop fire sees no backlog (Defense C).
        try:
            with open(state_file, 'w') as f:
                f.write(str(len(entries)))
        except Exception:
            pass

        # Done-ping to the log channel. Deduped so repeated Stop fires don't
        # re-ping; the dedup window is short enough that a genuine next-turn ping
        # still fires.
        import time
        time.sleep(1.5)   # let in-flight log webhook posts land before the ping
        ping_channel = _resolve_log_channel(session_id) or os.environ.get('DISCORD_LOG_CHANNEL_ID', '') or last_discord_chat_id
        if alert_user_id and ping_channel:
            ping_text = f'<@{alert_user_id}> done — waiting for your next message.'
            payload = json.dumps({'content': ping_text,
                                  'allowed_mentions': {'users': [alert_user_id]}})
            _post_discussion(session_id, ping_channel, bot_token, ping_text,
                             'Stop-doneping', payload=payload,
                             dedup_key=f'doneping|t{last_discord_idx}')
        sys.exit(0)

    if not last_text:
        sys.exit(0)

    if len(last_text) > 1850:
        last_text = last_text[:1847] + '...'

    mention_prefix = ''
    if alert_user_id and is_question(last_text):
        mention_prefix = f'<@{alert_user_id}> '

    message_content = f'{mention_prefix}**[turn done]** {last_text}'
    payload_dict = {'content': message_content}
    if mention_prefix and alert_user_id:
        payload_dict['allowed_mentions'] = {'users': [alert_user_id]}

    _post_discussion(session_id, last_discord_chat_id, bot_token, message_content,
                     'Stop-turndone', payload=json.dumps(payload_dict),
                     dedup_key=f'turndone|t{last_discord_idx}|{message_content}')

    # Advance the cursor so a repeated Stop fire finds no new backlog (Defense C).
    try:
        with open(state_file, 'w') as f:
            f.write(str(len(entries)))
    except Exception:
        pass


if __name__ == '__main__':
    main()
